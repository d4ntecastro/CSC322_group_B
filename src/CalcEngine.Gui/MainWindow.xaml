<Window
    x:Class="CalcEngine.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CalcEngine.Gui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Row="0"
            Margin="4"
            Background="#f3f3f3">

            <TextBox
                x:Name="CellAddressTextBox"
                Width="60"
                Margin="0,0,4,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontWeight="Bold"
                Text="A1" />

            <TextBlock
                Margin="4,0,8,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontStyle="Italic"
                FontWeight="Bold"
                Text="fx:" />

            <TextBox
                x:Name="FormulaTextBox"
                Margin="4"
                VerticalContentAlignment="Center"
                FontWeight="Bold"
                KeyDown="FormulaTextBox_KeyDown"
                Text="=SUM(A1:B10)" />

        </DockPanel>

        <DataGrid
            x:Name="SpreadsheetGrid"
            Grid.Row="1"
            AutoGenerateColumns="True"
            Background="White"
            CanUserAddRows="False"
            GridLinesVisibility="All"
            RowHeaderWidth="30"
            SelectedCellsChanged="SpreadsheetGrid_SelectedCellsChanged" />

        <StatusBar Grid.Row="2" Background="#e0e0e0">
            <StatusBarItem>
                <TextBlock
                    x:Name="StatusTextBlock"
                    Foreground="#333333"
                    Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
