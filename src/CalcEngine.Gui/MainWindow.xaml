<Window x:Class="CalcEngine.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalcEngine.Gui"
        mc:Ignorable="d"
        Title="CalcEngine" Height="600" Width="900">
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="AddressBox" Width="80" Margin="0,0,8,0" />
      <TextBlock Text="Formula:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="FormulaBar" Width="520" />
      <Button x:Name="EvaluateButton" Content="Evaluate" Margin="8,0,0,0" Click="EvaluateButton_Click" />
      <Button x:Name="SetCellButton" Content="Set Cell" Margin="8,0,0,0" Click="SetCellButton_Click" />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="CellsGrid" ItemsSource="{Binding Cells}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="CellOrRowHeader">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Address" Binding="{Binding AddressText}" IsReadOnly="True" Width="80" />
          <DataGridTextColumn Header="Formula" Binding="{Binding Formula}" Width="*" />
          <DataGridTextColumn Header="Value" Binding="{Binding Display}" IsReadOnly="True" Width="120" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="8,0,0,0">
        <TextBlock x:Name="OutputText" Padding="8" TextWrapping="Wrap">Welcome to CalcEngine WPF UI.</TextBlock>
      </Border>
    </Grid>
    </Grid>
</Window>
